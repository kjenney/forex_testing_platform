# Forex.com GAIN Capital API Configuration
FOREX_USERNAME=your_username_here
FOREX_PASSWORD=your_password_here
FOREX_APPKEY=your_appkey_here

# Database Configuration
DATABASE_URL=postgresql://trading_user:trading_pass@db:5432/trading_db

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change_this_to_a_random_secret_key

# Trading Configuration
DEFAULT_RISK_PERCENT=1.0
MAX_DAILY_LOSS_PERCENT=3.0
TRADING_PAIRS=EUR_USD,GBP_USD,USD_JPY
MAX_CONCURRENT_POSITIONS=3

# Redis Configuration (optional)
REDIS_URL=redis://redis:6379/0
